{
  "name": "local-pdf-forms-signer",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --manifest asset-manifest.json && node scripts/inject-precache.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:claims": "playwright test --project=desktop"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.149"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
